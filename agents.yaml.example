# ai-mem custom agent config
# Copy to ~/.config/ai-mem/agents.yaml (or $XDG_CONFIG_HOME/ai-mem/agents.yaml)
# Requires: pip install pyyaml  (or pip install ai-mem[config])
#
# This file only tunes SessionStart's one-line routing hint and posttool_hook's
# scoring. It does NOT decide which agents use ai-mem's memory -- that's decided per
# agent, by editing the agent's own prompt (see examples/agents/). This file just lets
# SessionStart recognize a *custom* agent type at all and name its collection.
#
# inject_agents: custom subagent types whose SessionStart routing line should name
#                their own subagent.<name> collection (built-in: general-purpose).
#                Listing an agent here does not push any memory content into it --
#                it still has to call mem_query/mem_add itself; see
#                examples/agents/example-agent-with-memory.md.
# signatures:    transcript markers used to identify a listed agent type at session start
# settings:      tunable hook parameters (all optional, fall back to defaults)

inject_agents:
  # - my-custom-coder

signatures:
  # - name: my-custom-coder
  #   markers:
  #     - "unique phrase from the agent's system prompt"
  #     - "another distinctive phrase"

settings:
  # min_label_score: 0.50          # [0.0–1.0] posttool_hook label threshold
  # query_k: 5                     # number of candidates fetched per posttool_hook query
  # session_start_verbose: false   # true restores the old SessionStart push: focus text,
  #                                # expired warnings, session deltas,
  #                                # git commits. Default (false) prints only the active/expert
  #                                # collection name — agents pull content via mem_query instead.
